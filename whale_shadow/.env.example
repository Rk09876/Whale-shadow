# Whale Shadow — environment variables

# how often (seconds) to poll NSE/BSE option chains during trading hours
POLL_SECONDS=30

# how often (seconds) to refresh FII/DII flows + block deals
FLOWS_INTERVAL_SECONDS=1800

# only poll during trading hours (1) or all the time (0)
TRADING_HOURS_ONLY=1

# how many snapshots per symbol to keep in the DB before pruning
SNAPSHOTS_KEEP=500

# timezone (used internally for hora calculations)
TZ=Asia/Kolkata
